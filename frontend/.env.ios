# Used by `npm run build:ios` (vite build --mode ios). Committed on purpose: these are public values baked into the
# iPhone app. Variables already set in the environment (e.g. Codemagic's VITE_BACKEND_URL) take priority over this file.
VITE_BACKEND_URL=https://api.zenithwalletracker.ca
# The app's App Store page for the "Update required" screen (https://apps.apple.com/app/id<Apple ID>).
# Leave empty until the app is live; the screen then just hides its "Open the App Store" button.
VITE_IOS_APP_STORE_URL=
