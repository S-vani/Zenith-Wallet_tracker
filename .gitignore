.claude/

# CI test logs and JUnit reports (also produced when running the CI commands locally)
# root only: a bare "reports/" also hid frontend/src/Reports/ (git ignores case on Windows)
/reports/

# IDE settings and its scratch database (per machine)
.idea/
identifier.sqlite

# SQLite side files and local database backups
*.db-wal
*.db-shm
*.db.gz
backups/

# deploy/deploy.sh: the build being prepared, the previous build kept for a rollback, and the deploy state
frontend/dist-next/
frontend/dist-prev/
frontend/dist-failed/
/.deploy/
