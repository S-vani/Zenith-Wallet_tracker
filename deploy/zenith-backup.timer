# Runs zenith-backup.service. Installed by: bash deploy/deploy.sh --install-backups
[Unit]
Description=Zenith database backup every 6 hours

[Timer]
OnCalendar=*-*-* 00/6:30:00 UTC
# catch up after the server was off at a run time
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
